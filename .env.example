# MESH configuration. Copy to src/mesh_server/.env for the brain, or to the
# repository root on the robot. Only the values under "Required" must be set.

# ---------------------------------------------------------------- Required --
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# The workstation's LAN address, not localhost. The robot connects here too.
LIVEKIT_URL=ws://192.168.1.71:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------ Personality --
# mesh, rocky, or tars. Any .txt in src/mesh_server/personalities/ works.
MESH_PERSONALITY=rocky

# ----------------------------------------------------------------- Models --
# GEMINI_MODEL=gemini-3-flash-preview
# DEEPGRAM_MODEL=nova-3
# Scene descriptions for ambient awareness. Defaults to GEMINI_MODEL.
# MESH_AMBIENT_MODEL=

# ------------------------------------------------------------- Turn-taking --
# Words required before a turn starts. Raise in a noisy room; 0 starts on any
# sound, which a robot with servos will trigger on its own.
# MESH_MIN_WORDS=2

# Require a phrase before engaging. Comma separated; empty means always
# listening. The timer resets on each exchange, so conversation flows normally
# once started.
# MESH_WAKE_PHRASES=hey rocky,rocky
# MESH_WAKE_TIMEOUT=45

# Silero VAD. stop_secs must stay below Deepgram's p99 transcript latency
# (~350ms) or final transcripts arrive after the turn has closed.
# MESH_VAD_STOP_SECS=0.2
# MESH_VAD_CONFIDENCE=0.6
# MESH_VAD_MIN_VOLUME=0.1
# MESH_SMART_TURN=1
# MESH_TURN_STOP_TIMEOUT=2.5
# MESH_SUMMARIZE_ABOVE_TOKENS=8000
# Discard transcripts that are the robot hearing itself. The echo
# canceller on the robot is the real defence; this is the backstop.
# MESH_ECHO_GUARD=1

# ------------------------------------------------------------------ Vision --
# MESH_VISION=1
# MESH_AMBIENT_VISION=1
# Images keeping full resolution in context; older ones become text.
# MESH_KEEP_IMAGES=1

# ----------------------------------------------------------------- Console --
# MESH_DASHBOARD=1
# MESH_DASHBOARD_PORT=8080
# 0.0.0.0 is reachable from a phone. Use 127.0.0.1 on an untrusted network.
# MESH_DASHBOARD_HOST=0.0.0.0
# MESH_METRICS=1

# =============================================================================
# Robot-side settings. These belong in the .env at the repository root on the
# Pi, alongside the LIVEKIT_* values above.
# =============================================================================

# Audio device indices. The client prints the table on startup. Use one device
# for both where possible, echo cancellation wants a shared clock.
# MESH_AUDIO_IN_DEVICE=1
# MESH_AUDIO_OUT_DEVICE=1
# Set to 2 if the microphone only opens in stereo.
# MESH_AUDIO_IN_CHANNELS=1
# Setting this to 0 gates the microphone instead, disabling interruption.
# MESH_ECHO_CANCEL=1
# Whether being interrupted also stops whatever the robot is physically
# doing. 0 lets a walk run to completion regardless.
# MESH_STOP_ON_INTERRUPT=1

# Camera. 180 if it is mounted upside down.
# MESH_CAMERA=1
# MESH_CAMERA_ROTATION=0
# MESH_CAMERA_WIDTH=1024
# MESH_CAMERA_HEIGHT=768
# MESH_CAMERA_FPS=5
# Set to 1 if red and blue come out swapped.
# MESH_CAMERA_SWAP_RB=0
# Continuous autofocus, where the sensor has it (Camera Module 3).
# MESH_CAMERA_AUTOFOCUS=1
# USB cameras only; ignored for ribbon-cable cameras.
# MESH_CAMERA_DEVICE=0

# Room and identities. Both halves must agree on the room.
# MESH_ROOM=mesh-robot-room
# MESH_BRAIN_IDENTITY=mesh-brain
# MESH_ROBOT_IDENTITY=mesh-robot
